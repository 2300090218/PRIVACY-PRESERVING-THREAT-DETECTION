# =============================================================================
# Privacy-Preserving Threat Detection Platform — Backend Environment Configuration
# =============================================================================
# Copy this file to '.env' for local development or set these variables in your
# deployment platform (Railway, Render, Fly.io, AWS ECS, GCP Cloud Run, Docker).
# NEVER commit the real .env file or real secrets to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION RUNTIME
# -----------------------------------------------------------------------------
APP_NAME="Privacy-Preserving Threat Detection"
# Environment: 'development' or 'production'
APP_ENV=development
# Set to 'false' in production to disable verbose stack traces and debug output
DEBUG=true
PORT=8000
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Development: Local asynchronous SQLite database (zero-friction setup)
DATABASE_URL=sqlite+aiosqlite:///./threat_detection.db

# Production: Persistent PostgreSQL database (Required for multi-instance / cloud)
# Note: Both postgresql:// and postgresql+asyncpg:// connection strings are supported
# DATABASE_URL=postgresql+asyncpg://postgres:YourSecurePassword@db-host:5432/threat_detection

# -----------------------------------------------------------------------------
# 3. SECURITY & CRYPTOGRAPHIC SECRETS
# -----------------------------------------------------------------------------
# Generate strong 32-byte hex secrets using: openssl rand -hex 32
# DO NOT reuse development keys in production!
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production
JWT_SECRET=change-this-to-a-secure-random-32-byte-hex-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Privacy Engine Salt (Used for HMAC-SHA256 pseudonymization tokens)
# Generate with: openssl rand -hex 32
PRIVACY_SALT=change-this-to-a-unique-random-salt-in-production

# AES-256-GCM Field-Level Encryption Key (32-byte / 256-bit base64url or hex string)
# NEVER commit the real encryption key to source control!
PRIVACY_ENCRYPTION_KEY=change-this-to-a-secure-32-byte-key-in-production
PRIVACY_KEY_ID=privacy-key-v1

# -----------------------------------------------------------------------------
# 4. CORS & NETWORKING
# -----------------------------------------------------------------------------
# Allowed CORS origins for the API.
# Formats supported: JSON list or comma-separated string
# Development:
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Production (set to your deployed frontend domain on Vercel):
# CORS_ORIGINS=https://your-frontend-project.vercel.app

# Internal / Public WebSocket URL reference
WEBSOCKET_URL=ws://127.0.0.1:8000/ws

# -----------------------------------------------------------------------------
# 5. MACHINE LEARNING & FEDERATED LEARNING
# -----------------------------------------------------------------------------
MODEL_DIR=./ml/models
DATASET_DIR=./ml/datasets
FL_SERVER_HOST=0.0.0.0
FL_SERVER_PORT=8080
FL_MIN_CLIENTS=3
FL_ROUNDS=5

# -----------------------------------------------------------------------------
# 6. RETENTION & OPERATIONAL MODE
# -----------------------------------------------------------------------------
# Options: TEST (allows running security scenarios), LIVE (production telemetry)
OPERATIONAL_MODE=TEST
EVENT_RETENTION_DAYS=90
ALERT_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=365

# -----------------------------------------------------------------------------
# 7. FRONTEND PUBLIC ENVIRONMENT VARIABLES (Reference for Vercel)
# -----------------------------------------------------------------------------
# Set these in the Vercel project dashboard under Settings -> Environment Variables:
# NEXT_PUBLIC_API_URL=https://<your-deployed-backend-domain>
# NEXT_PUBLIC_WS_URL=wss://<your-deployed-backend-domain>/ws
# Enable safe public demo mode for public portfolio / presentation access:
# Set to 'true' to allow unauthenticated public visitors to view sanitized demo dashboard.
# Set to 'false' to enforce strict Enterprise authentication across all routes.
NEXT_PUBLIC_DEMO_MODE=true

# -----------------------------------------------------------------------------
# 8. ENTERPRISE EMAIL & TWO-STEP VERIFICATION (SMTP)
# -----------------------------------------------------------------------------
# Server-side SMTP configuration for dispatching one-time verification codes (OTP).
# For Gmail SMTP, use a dedicated Google App Password (never your personal Gmail password).
# These variables must REMAIN server-side. NEVER expose them with NEXT_PUBLIC_.
AUTH_SMTP_HOST=smtp.gmail.com
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=your-service-account@gmail.com
AUTH_SMTP_PASSWORD=your-google-app-password
AUTH_EMAIL_FROM=no-reply@threat-detection.internal
AUTH_SMTP_USE_TLS=true
AUTH_OTP_EXPIRE_MINUTES=5
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_FAILED_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
INITIAL_ADMIN_EMAIL=security-admin@threat-detection.local
INITIAL_ADMIN_PASSWORD=your-secure-admin-password
