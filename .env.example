# ============================================================
# Privacy-Preserving Threat Detection Platform Configuration
# ============================================================

# Environment
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database
# Default: SQLite asynchronous local fallback for zero-friction setup
DATABASE_URL=sqlite+aiosqlite:///./threat_detection.db
# For PostgreSQL (Production):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/threat_detection

# Security & Authentication
SECRET_KEY=change-this-in-production-super-secret-key-32chars
JWT_SECRET=change-this-in-production-jwt-secret-key-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Privacy Engine Salt (Used for HMAC-SHA256 pseudonymization tokens)
PRIVACY_SALT=change-this-in-production-privacy-salt-isolated

# CORS & Networking
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
WEBSOCKET_URL=ws://127.0.0.1:8000/ws

# Machine Learning & Federated Learning
MODEL_DIR=./ml/models
DATASET_DIR=./ml/datasets
FL_SERVER_HOST=0.0.0.0
FL_SERVER_PORT=8080
FL_MIN_CLIENTS=3
FL_ROUNDS=5

# Telemetry & Operating Mode
# Options: LIVE, TEST, OFFLINE
OPERATIONAL_MODE=TEST
