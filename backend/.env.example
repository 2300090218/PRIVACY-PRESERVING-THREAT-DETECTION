# =============================================================================
# Privacy-Preserving Threat Detection Platform - Backend Configuration
# =============================================================================
# Copy this file to 'backend/.env' (or root '.env') for local execution.
# NEVER commit production secrets, private keys, or passwords to Git.
# =============================================================================

# 1. APPLICATION RUNTIME & HOSTING
APP_NAME="Privacy-Preserving Threat Detection Platform"
# Environment: 'development' or 'production' (in production, secure defaults are enforced)
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# 2. DATABASE CONFIGURATION
# Local Async SQLite (default for development):
DATABASE_URL=sqlite+aiosqlite:///./threat_detection.db
# Cloud PostgreSQL (production example):
# DATABASE_URL=postgresql+asyncpg://postgres:YourSecurePassword@host:5432/threat_detection

# 3. SECURITY & CRYPTOGRAPHIC SECRETS
# In production, application fails fast if secrets use default fallback values.
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production
JWT_SECRET=change-this-to-a-secure-random-32-byte-hex-string-in-production
SESSION_SECRET=change-this-to-a-secure-random-32-byte-hex-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Privacy Engine Salt (Used for SHA-256 salted HMAC pseudonymization of IP/User/Device IDs)
# Irreversible hashing ensuring raw IPs never reach the detection engine or telemetry
PRIVACY_SALT=change-this-to-a-unique-random-salt-in-production
PRIVACY_ENCRYPTION_KEY=change-this-to-a-secure-32-byte-key-in-production
PRIVACY_KEY_ID=privacy-key-v1

# 4. CORS & WEBSOCKET PERMISSIONS
# Comma-separated list or JSON array of allowed frontend origins (never '*' in production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# In production, set to your Vercel deployment:
# ALLOWED_ORIGINS=https://privacy-preserving-threat-detection.vercel.app

# 5. REAL-TIME TELEMETRY TRAFFIC SIMULATOR
# Enables automatic background generation of benign and attack telemetry for live demos
ENABLE_SIMULATOR=true
SIMULATOR_INTERVAL_SECONDS=4.0

# 6. FEDERATED LEARNING CONFIGURATION (DP-FedAvg)
MODEL_DIR=./ml/models
DATASET_DIR=./ml/datasets
FL_SERVER_HOST=0.0.0.0
FL_SERVER_PORT=8080
FL_MIN_CLIENTS=3
FL_ROUNDS=5

# 7. OPERATIONAL MODE & DATA RETENTION
OPERATIONAL_MODE=TEST
EVENT_RETENTION_DAYS=90
ALERT_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=365
