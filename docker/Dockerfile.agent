# Production Dockerfile for Local Organization Agent
FROM python:3.12-slim

WORKDIR /app

# Non-root user for cybersecurity hardening
RUN groupadd -g 1002 agentgroup && \
    useradd -u 1002 -g agentgroup -s /bin/bash agentuser

COPY backend/requirements.txt .
RUN pip install --no-cache-dir httpx pydantic pydantic-settings

COPY . /app

RUN chown -R agentuser:agentgroup /app

USER agentuser

ENV PYTHONPATH=/app
ENV CENTRAL_API_URL=http://central-api:8000
ENV AGENT_ORGANIZATION_ID=org_enterprise_a
ENV AGENT_AGENT_ID=agent-dmz-01

CMD ["python", "-m", "agent.main", "--loop", "--interval", "10"]
