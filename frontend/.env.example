# ============================================================
# Privacy-Preserving Threat Detection Platform - Frontend
# ============================================================

# Backend REST API URL
# Development: http://127.0.0.1:8000
# Production: https://<your-backend-domain>
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Backend Persistent WebSocket URL
# Development: ws://127.0.0.1:8000/ws
# Production: wss://<your-backend-domain>/ws
# Note: If omitted, the frontend will automatically derive the WebSocket endpoint from NEXT_PUBLIC_API_URL
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws
